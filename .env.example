# --- Discord ---
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Optional: register commands to one server instantly. Leave empty for global (can take up to an hour).
DISCORD_GUILD_ID=

# Channel(s) where /request can be used. Right-click a channel -> Copy Channel ID (Developer Mode).
# Comma-separate multiple. Empty = any channel.
REQUEST_CHANNEL_IDS=
# Access roles, created automatically if the bot has Manage Roles. Administrators always have access.
# "Scryer Request": /request + requesting from discovery posts. "Scryer Manager": also /discovery and /forcesearch.
# Optional: use different role names.
REQUEST_ROLE_NAME=Scryer Request
MANAGER_ROLE_NAME=Scryer Manager

# --- Scryer ---
# Base URL of your Scryer instance (include any base path, e.g. http://scryer:8080/scryer).
# "/graphql" is appended automatically.
SCRYER_URL=http://localhost:8080
# API key from Scryer -> Settings -> API Keys (starts with "ska"). Needs permission to manage titles.
SCRYER_API_TOKEN=
# Metadata language for search results (ISO 639-2)
SCRYER_LANGUAGE=eng

# --- Discovery feeds (set up in Discord with /discovery) ---
# How often the discovery posts refresh from Scryer (they also refresh after every request)
DISCOVERY_REFRESH_HOURS=24
# Max titles per feed (5 per page)
DISCOVERY_MAX_ITEMS=50
# Where the /discovery setup is saved
DATA_DIR=./data

# Minutes of inactivity before a /request selection expires
SESSION_TTL_MINUTES=15
